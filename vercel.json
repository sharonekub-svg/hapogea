{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "echo Static Hapogea demo ready",
  "outputDirectory": "hapogea-preview",
  "framework": null,
  "installCommand": "echo skip",
  "functions": {
    "api/winner-feed.js": { "maxDuration": 60 },
    "api/winner-cron.js": { "maxDuration": 30 },
    "api/recommendation-bot.js": { "maxDuration": 60 },
    "api/recommendation-stats.js": { "maxDuration": 60 },
    "api/reuven.js": { "maxDuration": 45 },
    "api/reuven-slip.js": { "maxDuration": 45 },
    "api/results-ai.js": { "maxDuration": 55 },
    "api/premium-validate.js": { "maxDuration": 10 },
    "api/premium-create.js": { "maxDuration": 10 },
    "api/manual-results.js": { "maxDuration": 15 },
    "api/sofascore.js": { "maxDuration": 15 }
  },
  "headers": [
    {
      "source": "/",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/index.html",
      "headers": [
        { "key": "Cache-Control", "value": "no-cache, no-store, must-revalidate" },
        { "key": "Pragma", "value": "no-cache" }
      ]
    },
    {
      "source": "/wc-splash.mp4",
      "headers": [
        { "key": "Content-Type", "value": "video/mp4" },
        { "key": "Cache-Control", "value": "public, max-age=31536000, immutable" }
      ]
    }
  ],
  "rewrites": [
    { "source": "/api/(.*)", "destination": "/api/$1" },
    { "source": "/((?!wc-splash.mp4).*)", "destination": "/index.html" }
  ],
  "crons": [
    { "path": "/api/winner-cron", "schedule": "0 21 * * *" },
    { "path": "/api/recommendation-bot", "schedule": "5 21 * * *" }
  ]
}
